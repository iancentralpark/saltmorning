DATABASE_URL="postgresql://curriculum:curriculum@localhost:5432/curriculum_platform?schema=public"
GEMINI_API_KEY=""
# Defaults — override only if needed
GEMINI_MODEL_PRO="gemini-2.5-pro"
GEMINI_MODEL_FLASH="gemini-2.5-flash"
# Fallback when a caller omits model (materials path)
GEMINI_MODEL="gemini-2.5-flash"
PORTAL_API_KEY="dev-portal-key"
# Require x-organization-code on portal routes when API key is set
# PORTAL_REQUIRE_ORG="1"
AUTH_SECRET="curricumap-dev-secret"
# Optional pin for POST /api/auth/demo-login
# DEMO_LOGIN_PIN=""
# Set to 1 to hide demo org picker (Google-only)
# DEMO_LOGIN_DISABLED="0"
# Require login for /map /schedule when 1
# AUTH_REQUIRED="0"
# Google OAuth (optional — enables "Google" button when both set)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Microsoft Entra ID OAuth (optional)
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_TENANT_ID="common"
# MICROSOFT_REDIRECT_URI="http://localhost:3000/api/auth/microsoft/callback"
# Sign in with Apple (optional — .p8 private key)
# APPLE_CLIENT_ID=""
# APPLE_TEAM_ID=""
# APPLE_KEY_ID=""
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_REDIRECT_URI="http://localhost:3000/api/auth/apple/callback"
# OAUTH_DEFAULT_ORG="salt-morning"
# OAUTH_EMAIL_ORG_MAP="teacher@acme.edu:acme-academy"
# Cron: POST /api/cron/calendar-sync
CRON_SECRET="dev-cron-secret"
# Optional pull-through to Salt Morning internal cron
# SALT_MORNING_URL="http://localhost:8790"
# SALT_MORNING_CRON_SECRET="dev-cron-secret"
# seed | prisma
CURRICULUM_STORE="seed"
# memory | prisma
SCHEDULE_STORE="memory"
