DATABASE_URL="postgresql://curriculum:curriculum@localhost:5432/curriculum_platform?schema=public"
GEMINI_API_KEY=""
# Defaults — override only if needed
GEMINI_MODEL_PRO="gemini-2.5-pro"
GEMINI_MODEL_FLASH="gemini-2.5-flash"
# Fallback when a caller omits model (materials path)
GEMINI_MODEL="gemini-2.5-flash"
PORTAL_API_KEY="dev-portal-key"
# Require x-organization-code on portal routes when API key is set
# PORTAL_REQUIRE_ORG="1"
AUTH_SECRET="curricumap-dev-secret"
# Optional pin for POST /api/auth/demo-login
# DEMO_LOGIN_PIN=""
# Cron: POST /api/cron/calendar-sync
CRON_SECRET="dev-cron-secret"
# Optional pull-through to Salt Morning internal cron
# SALT_MORNING_URL="http://localhost:8790"
# SALT_MORNING_CRON_SECRET="dev-cron-secret"
# seed | prisma
CURRICULUM_STORE="seed"
# memory | prisma
SCHEDULE_STORE="memory"
