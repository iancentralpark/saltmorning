# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
# GOOGLE_API_KEY=          # API key for Google Picker (HTTP referrer restricted)
# GOOGLE_APP_ID=           # Cloud project number (for Picker)

# --- Shared Vocab Booster (Mr.Park engine thin-proxy + shared Supabase) ---
# Tenant MUST stay salt-morning (live). Do not rename.
# Preferred: proxy all student vocab calls to Mr.Park /api/vocab/v1
VOCAB_ENGINE_URL=https://mrpark-class-api-production.up.railway.app
VOCAB_ENGINE_TOKEN=
# Fallback origin alias (used if VOCAB_ENGINE_URL unset)
# VOCAB_CENTRAL_API_BASE=https://mrpark-class-api-production.up.railway.app
# Vocab Booster ONLY — shared Mr.Park Supabase project, tenant-scoped (tenant_id=salt-morning).
# Do NOT store Salt Morning school ops (dollars/messenger/attendance/bus) in Mr.Park tables.
# Project ref: tedzjzntesjslpiefbbi
SUPABASE_URL=https://tedzjzntesjslpiefbbi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_ENABLED=true
VOCAB_TENANT_ID=salt-morning
VOCAB_TENANT_PUBLIC_KEY=pk_salt_morning
VOCAB_SKIP_LUCKY_DRAW=true

# --- Salt Morning ops DB (Railway Postgres, schema salt_morning) ---
# Completely separate from Mr.Park. Used for dollars, messenger, attendance, bus daily, push.
DATABASE_URL=
OPS_DB_SCHEMA=salt_morning
# Optional: keep writing Dollars to Sheets as a read-only emergency mirror
# DOLLARS_SHEET_MIRROR=true

# Parent web push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@saltmorning.study
