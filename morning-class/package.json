{
  "name": "salt-morning-class",
  "version": "0.1.0",
  "private": true,
  "description": "Salt Academy Morning Class — teacher admin & student/parent portals",
  "main": "src/index.js",
  "scripts": {
    "start": "node scripts/start-with-solver.js",
    "dev": "node --watch src/index.js",
    "solver": "python3 solver/main.py",
    "solver:install": "pip3 install -r solver/requirements.txt",
    "vocab:sync": "bash scripts/sync-vocab-core.sh",
    "vocab:backfill-sheets": "node scripts/backfill-vocab-sheets-to-supabase.js",
    "ops:backfill": "node scripts/backfill-sheets-to-ops-db.js",
    "ops:backfill:apply": "node scripts/backfill-sheets-to-ops-db.js --apply",
    "init-sheets": "node scripts/init-spreadsheet.js",
    "check-setup": "node scripts/check-setup.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7"
  }
}
